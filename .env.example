# Copie para .env e preencha com valores reais. Nunca comite o .env de verdade.

# Connection string do Postgres (Neon, Supabase, etc), COM pooling — usada em runtime.
DATABASE_URL=""

# Connection string SEM pooling (direta) — usada só pelo `prisma migrate`.
# No Neon: mesma tela, desligue o toggle "Connection pooling" para ver essa versão.
DIRECT_URL=""

# Chave usada para assinar o cookie de sessão (JWT). Gere uma forte com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
