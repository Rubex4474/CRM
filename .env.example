# Copie para .env e preencha com valores reais. Nunca comite o .env de verdade.

# Connection string do Postgres (Neon, Supabase, etc), COM pooling — usada em runtime.
DATABASE_URL=""

# Connection string SEM pooling (direta) — usada só pelo `prisma migrate`.
# No Neon: mesma tela, desligue o toggle "Connection pooling" para ver essa versão.
DIRECT_URL=""

# Chave usada para assinar o cookie de sessão (JWT). Gere uma forte com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# App Secret do App criado em developers.facebook.com (aba Configurações básicas).
# Usado só pra conferir a assinatura dos webhooks de Lead Ads da Meta.
META_APP_SECRET=""

# Token que você escolhe e cola no painel de Webhooks do App da Meta (campo
# "Verificar token"). Gere um valor aleatório com:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=""
