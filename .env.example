# Copie para .env e preencha com valores reais. Nunca comite o .env de verdade.

# Connection string do Postgres (Neon, Supabase, etc). Ex:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=""

# Chave usada para assinar o cookie de sessão (JWT). Gere uma forte com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
